# docker-compose 环境变量（生产环境）

PROJ_ENV=PROD

# 数据库host（不需要修改）
DB_HOST=oj-postgres
# 数据库名
DB_NAME=onlinejudge
DB_PORT=5432

PG_BOUNCER_PORT=6432

# Redis
REDIS_HOST=oj-redis
REDIS_PORT=6379

# JudgeAgent 调度参数
JUDGE_AGENT_HEARTBEAT_INTERVAL=10
JUDGE_AGENT_LEASE_SECONDS=45
JUDGE_AGENT_OFFLINE_SECONDS=45
JUDGE_AGENT_MAX_RETRIES=3
JUDGE_AGENT_TASK_POLL_INTERVAL=2

# 默认单机判题节点
JUDGE_AGENT_NAME=local-judge-agent
JUDGE_NODE_CONCURRENCY=2
JUDGE_AGENT_LANGUAGES=c,cpp,java,py,go,js
JUDGE_AGENT_MIN_PRIORITY=0
JUDGE_AGENT_CACHE_DAYS=30
JUDGE_AGENT_CREDENTIAL_WAIT_SECONDS=60
JUDGE_AGENT_PIDS_LIMIT=512
JUDGE_AGENT_TMPFS_SIZE=512m


# ----需要填写的变量----

# 数据库用户
DB_USER=
# 数据库密码
DB_PASSWORD=
# 后台超级管理初始用户名
ROOT_USERNAME=
# 后台超级管理初始密码
ROOT_PASSWORD=
