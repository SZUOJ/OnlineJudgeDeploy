PROJ_ENV=PROD             # 生产环境（不需要修改）

DB_HOST=oj-postgres       # 数据库host（不需要修改）
DB_NAME=onlinejudge       # 数据库名
DB_USER=onlinejudge       # 数据库用户
DB_PASSWORD=onlinejudge   # 数据库密码
DB_PORT=5432

REDIS_HOST=oj-redis       # Redis
REDIS_PORT=6379

MQ_HOST=oj-mq             # 消息队列host（不需要修改）
MQ_USER=ojmq
MQ_PASS=onlinejudge

ROOT_USERNAME=root        # 后台超级管理初始用户名
ROOT_PASSWORD=rootroot    # 后台超级管理初始密码

JUDGER_SERVER_URL=http://oj-judger:8080  # 判题机URL（不需要修改）
JUDGE_SERVER_TOKEN=JUDGE_SERVER_TOKEN