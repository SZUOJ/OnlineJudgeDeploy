# docker-compose 环境变量（开发环境）

# 开发环境（不需要修改）
PROJ_ENV=DEV

# 数据库host（不需要修改）
DB_HOST=oj-postgres
# 数据库名
DB_NAME=onlinejudge
# 数据库用户
DB_USER=onlinejudge
# 数据库密码
DB_PASSWORD=onlinejudge
DB_PORT=5432

PG_BOUNCER_PORT=6432

# Redis
REDIS_HOST=oj-redis
REDIS_PORT=6379

# 后台超级管理初始用户名
ROOT_USERNAME=root
# 后台超级管理初始密码
ROOT_PASSWORD=rootroot

# 判题机URL（不需要修改）
JUDGER_SERVER_URL=http://oj-judger:8080
JUDGE_SERVER_TOKEN=JUDGE_SERVER_TOKEN
