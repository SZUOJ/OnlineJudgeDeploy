JUDGE_AGENT_WS_URL=wss://oj.example.com/ws/judge/
JUDGE_AGENT_FILE_URL=https://oj.example.com/api/judge-agent/files/
JUDGE_AGENT_NODE_ID=00000000-0000-0000-0000-000000000000
JUDGE_AGENT_NAME=judge-node-1
JUDGE_NODE_CONCURRENCY=2
# 容器内总进程/线程上限；提高并发前应同时评估 JVM 线程数。
JUDGE_AGENT_PIDS_LIMIT=512
# Java/Node 可写临时空间的内存型 tmpfs 上限。
JUDGE_AGENT_TMPFS_SIZE=512m
JUDGE_AGENT_LANGUAGES=c,cpp,java,py,go,js
JUDGE_AGENT_MIN_PRIORITY=0
JUDGE_AGENT_CACHE_DAYS=30
JUDGE_AGENT_TLS_VERIFY=true
